{
  "name": "somewhere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A quiet coastal island shared across time. Someone, somewhere, is experiencing life at the same time as you.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
