    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
